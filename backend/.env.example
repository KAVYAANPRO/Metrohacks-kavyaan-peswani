# ---- MongoDB Atlas ----
# Paste your Atlas connection string here, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave empty to run fully in-memory (offline demo mode).
MONGODB_URI=
MONGODB_DB=spotvalue

# ---- Server ----
PORT=8000
CORS_ORIGINS=*

# ---- AI: Google Gemini (recommended, no battery cost) ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Optional local LLM (Gemma via Ollama), used only if Gemini fails ----
OLLAMA_URL=http://localhost:11434
# Set this to the exact Gemma tag you pulled (check with: ollama list)
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_MS=30000

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Email (access requests to admins' Gmail) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173
